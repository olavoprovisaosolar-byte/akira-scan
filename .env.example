# Variáveis de ambiente — AkiraScan
# Copie para .env e preencha conforme necessário.

# Bot NexusToons — hospedagem
# TELEGRA_UPLOAD_URL=https://telegra.ph/upload
# TELEGRA_DELAY_MS=600
# TELEGRA_SKIP=1
# NEXUSTOONS_HOSTING_ADAPTER=cloud-static

# Cloudflare cookies (obrigatório em IPs de datacenter / GitHub Actions)
# Copiar do DevTools → Application → Cookies em nexustoons.com após resolver o challenge no browser:
# NEXUSTOONS_COOKIE=cf_clearance=...; outros=...
# CF_CLEARANCE=...

# Proxies de imagens no Cloudflare Pages (Settings → Environment variables)
# GITHUB_CDN_USER=olavoprovisaosolar-byte
# GITHUB_CDN_TOKEN=ghp_...   # PAT com leitura dos repos privados akira-cdn-*
# GITHUB_CDN_PREFIX=akira-cdn
# DISCORD_BOT_TOKEN=...      # renova anexos Discord expirados em /api/discord-img

# API Cloudflare — publicação automática de capítulos (R2)
# AKIRA_PUBLISH_TOKEN=seu-token-secreto
# AKIRA_PUBLISH_BASE_URL=https://akira-scan.pages.dev
# AKIRA_SCAN_BASE_URL=https://akira-scan.pages.dev
# AKIRA_PUBLISH_API=1

# Cloudflare deploy (CI/local)
# CLOUDFLARE_API_TOKEN=
# CF_PAGES_PROJECT=akira-scan

# Netlify Blobs (API de utilizadores)
# NETLIFY_BLOBS_CONTEXT=dev
